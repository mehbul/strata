# Rust build output
/target

# Vendored llama.cpp runtime (~1.3 GB) — fetched, not authored.
# `strata serve` finds it here; see README for the download.
/runtime

# Everything under rocm/ is local to one machine: model weights and their
# measurements, a vendored ROCm SDK, its caches, and whatever GPU-detection
# script that machine happens to have. None of it is authored here.
/rocm/
*.gguf

# Web
/web/node_modules
/web/dist
/web/*.tsbuildinfo

# Local state
.strata_usage*
.strata_kv*

# pi's project settings - points at a server on this machine
/.pi
